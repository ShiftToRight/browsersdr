{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browsersdr.com/schemas/compatibility-report-v1.json",
  "title": "BrowserSDR compatibility report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "reportId",
    "createdAt",
    "build",
    "environment",
    "receiver",
    "observations",
    "redaction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportType": { "const": "compatibility" },
    "reportId": { "type": "string", "pattern": "^BC-", "maxLength": 64 },
    "createdAt": { "type": "string", "format": "date-time", "maxLength": 40 },
    "build": { "type": "object" },
    "environment": { "type": "object" },
    "receiver": { "type": "object" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "result"],
        "properties": {
          "service": {
            "enum": [
              "connection",
              "spectrum",
              "tuning",
              "audio",
              "rds",
              "dab",
              "digital-decode",
              "recording-export",
              "replay"
            ]
          },
          "result": { "enum": ["working", "degraded", "not-working"] }
        }
      }
    },
    "notes": { "type": "string", "maxLength": 1000 },
    "redaction": { "type": "object" }
  }
}
